# Raw FIRMS archive files are large and licensed for download, never committed
data/raw/*
!data/raw/.gitkeep

# Secrets (FIRMS_MAP_KEY lives in the environment or a local .env)
.env
.env.*
*.key

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Large Natural Earth source files (regions.geojson is built from them and committed)
data/external/ne_10m_*

# Video build outputs (large; rebuilt by the scripts in video/)
video/clips/
video/cards/
video/voice*/
video/segments*/
video/fonts/
video/preview/
video/sheet*/
video/*.mp4
video/*.wav
video/*.ass
video/*.log
